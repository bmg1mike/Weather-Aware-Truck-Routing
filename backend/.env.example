# Copy to .env (never commit .env). All values are read from the environment.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Server-side only. Never expose to the frontend bundle.
TOMTOM_API_KEY=
# Leave empty to use the in-process local-memory cache (development).
REDIS_URL=
# sustained (default, spec 6.2 [ASSUMPTION]) or gust
WIND_SOURCE=sustained
